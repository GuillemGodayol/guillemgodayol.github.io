---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";

const { title, description, currentLang, ui } = Astro.props;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="terrain-bg"></div>
    <div class="page-shell">
      <header class="site-header">
        <a class="site-mark" href={currentLang === "ca" ? "/" : `/${currentLang}/`}>
          <span>{ui.siteName[currentLang]}</span>
        </a>
        <LanguageSwitcher currentLang={currentLang} languages={ui.languages} />
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>{ui.tagline[currentLang]}</p>
        <a href="#top">{ui.labels[currentLang].backToTop}</a>
      </footer>
    </div>
  </body>
</html>

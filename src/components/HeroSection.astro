---
const { profile, labels } = Astro.props;
---

<section class="hero panel">
  <div class="hero-copy">
    <h1>{profile.name}</h1>
    <p class="headline">{profile.headline}</p>
    <p class="bio">{profile.bio}</p>
    <div class="hero-meta">
      <span>{profile.location}</span>
      <span>{profile.contact.instagramCta}: {profile.contact.instagram}</span>
    </div>
  </div>
  <aside class="hero-visual">
    <img
      src={profile.photo.src}
      alt={profile.photo.alt || profile.name}
      class="hero-photo"
      loading="eager"
    />
  </aside>
</section>
